<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SecureBank Pro - Enterprise Web Security Lab</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
</head>
<body>

  <!-- Mode Banner Indicator -->
  <div class="mode-banner <%= isSecureMode ? 'secure-mode' : 'attack-mode' %>">
    MODE: <strong><%= isSecureMode ? 'SECURE IMPLEMENTATION (PROTECTED)' : 'ATTACK IMPLEMENTATION (VULNERABLE)' %></strong>
    <a href="/toggle-mode" class="mode-toggle-btn">
      SWITCH TO <%= isSecureMode ? 'ATTACK MODE' : 'SECURE MODE' %>
    </a>
  </div>

  <!-- Navigation Bar -->
  <nav class="navbar">
    <div style="display: flex; align-items: center; gap: 20px;">
      <a href="/" class="navbar-brand">
        SecureBank <span>Pro</span>
      </a>
      <div style="font-size: 11px; background: rgba(255, 255, 255, 0.1); padding: 4px 10px; border-radius: 3px; font-weight: bold; color: #d1d8e0; border: 1px solid rgba(255, 255, 255, 0.15); display: flex; align-items: center; gap: 6px;">
        Visited: <span id="stat-visited" style="color: #f1c40f;"><%= globalVisited %></span> | Tried: <span id="stat-tried" style="color: #ffffff;"><%= globalTried %></span> | Solved: <span id="stat-solved" style="color: #27ae60;"><%= globalSolved %></span>
      </div>
      <script>
        (function(){
          const keys = {
            visited: 'securebankpro_visited_shashank',
            tried: 'securebankpro_tried_shashank',
            solved: 'securebankpro_solved_shashank'
          };
          function poll(){
            Object.entries(keys).forEach(([stat, key]) => {
              fetch('https://countapi.mileshilliard.com/api/v1/get/' + key)
                .then(r => r.json())
                .then(d => {
                  const el = document.getElementById('stat-' + stat);
                  if(el && d.value !== undefined) el.textContent = d.value;
                }).catch(()=>{});
            });
          }
          setInterval(poll, 8000);
        })();
      </script>
    </div>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <% if (user) { %>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/transfer">Transfer</a></li>
        <li><a href="/transactions">Transactions</a></li>
        <li><a href="/profile">Profile</a></li>
        <% if (user.role === 'admin') { %>
          <li><a href="/admin">Admin Panel</a></li>
        <% } %>
        <li><a href="/logout" class="btn-logout">Logout (<%= user.username %>)</a></li>
      <% } else { %>
        <li><a href="/login">Login</a></li>
      <% } %>
    </ul>
  </nav>

  <div class="container">
